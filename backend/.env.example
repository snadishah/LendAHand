DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"
GEMINI_API_KEY="your-gemini-key-here"
PORT=5050
NODE_ENV=development
SENTRY_DSN="https://your-key@o000000.ingest.sentry.io/000000"
APP_URL="http://localhost:5173"
# Email (generic SMTP). Examples:
#   Gmail:   SMTP_HOST=smtp.gmail.com  (app password required)
#   Outlook: SMTP_HOST=smtp-mail.outlook.com
#   Zoho:    SMTP_HOST=smtp.zoho.com
SMTP_HOST="smtp-mail.outlook.com"
SMTP_PORT=587
SMTP_USER="you@hotmail.com"
SMTP_PASS="your-email-or-app-password"
EMAIL_FROM="LendAHand <you@hotmail.com>"
